FROM runpod/pytorch:1.0.3-cu1281-torch260-ubuntu2204

WORKDIR /workspace

RUN pip install --no-cache-dir \
    torchaudio==2.6.0 \
    transformers==5.3.0 \
    peft==0.18.1 \
    diffusers==0.32.2 \
    safetensors==0.7.0 \
    accelerate==1.13.0 \
    pedalboard==0.9.22 \
    pyloudnorm==0.2.0 \
    soundfile==0.13.1 \
    loguru==0.7.3 \
    soxr==1.0.0 \
    huggingface_hub \
    runpod

COPY scripts/handler.py /workspace/handler.py

CMD ["python3", "-u", "/workspace/handler.py"]
